# CMG Configuration Manager Environment Variables
# Copy this file to .env and customize values for your environment

# Application URLs
CMG_CM_BASE_URL=http://172.20.115.41/cmg.cm/
CMG_CM_DEV_URL=http://172.20.115.41/cmg.cm/
CMG_CM_TEST_URL=http://172.20.115.41/cmg.cm/
CMG_CM_PROD_URL=http://172.20.115.41/cmg.cm/

# Login Credentials
CMG_CM_USERNAME=niceadmin
CMG_CM_PASSWORD=aastra
CMG_CM_DATABASE_ID=1

# Timeout Configuration (in milliseconds)
TIMEOUT_DEFAULT=5000
TIMEOUT_SLOW=3000
TIMEOUT_STEP=1000
TIMEOUT_NAVIGATION=10000
TIMEOUT_MODAL=2000

# Slow Mode Configuration
SLOW_MODE_ENABLED=true
SLOW_MODE_MULTIPLIER=2.0

# Contact Profile Test Data
CONTACT_PROFILE_NAME=AI R&D
CONTACT_PROFILE_PBX_TYPE=17
CONTACT_PROFILE_DESCRIPTION=test
CONTACT_PROFILE_PBX_SELECTION=icp1 - Alt.ext.1misc1 -

# Element Selectors (Advanced Configuration)
SELECTOR_PBX_TABLE=#pbxtable
SELECTOR_PBX_CELL=icp1 - Alt.ext.1misc1 -
SELECTOR_MODAL_DATA1=#modalData1
SELECTOR_MODAL_DATA3=#modalData3
SELECTOR_MODAL_DATA6=#modalData6

# Test Environment
TEST_ENV=development
